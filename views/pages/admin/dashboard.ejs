            <i data-lucide="building" class="w-5 h-5 text-cyan-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-gray-900"><%= stats.activeHrs %></p>
            <p class="text-[10px] text-gray-400">Perusahaan Aktif</p>
        </div>
    </div>
    <div class="stat-card animate-in animate-delay-6 bg-white border border-gray-200 rounded-2xl p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0">
            <i data-lucide="credit-card" class="w-5 h-5 text-blue-600"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-gray-900">Rp 12.4jt</p>
            <p class="text-[10px] text-gray-400">Pendapatan Bulan Ini</p>
        </div>
    </div>
    <div class="stat-card animate-in animate-delay-6 bg-white border border-gray-200 rounded-2xl p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-pink-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="clock" class="w-5 h-5 text-pink-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-gray-900">3.5 hari</p>
            <p class="text-[10px] text-gray-400">Rata-rata Respon</p>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <div class="lg:col-span-2 animate-in animate-delay-7 bg-white border border-gray-200 rounded-2xl p-5">
        <div class="flex items-center justify-between mb-5">
            <div>
                <h3 class="text-sm font-bold text-gray-900">Statistik Pertumbuhan</h3>
                <p class="text-xs text-gray-400 mt-0.5">Tren pengguna & lamaran 6 bulan terakhir</p>
            </div>
            <div class="flex items-center gap-1 bg-gray-100 rounded-lg p-0.5">
                <button class="chart-period-btn px-3 py-1.5 text-xs rounded-md bg-blue-600 text-white font-medium" data-period="6m">6 Bulan</button>
                <button class="chart-period-btn px-3 py-1.5 text-xs rounded-md text-gray-500 hover:text-gray-700" data-period="1y">1 Tahun</button>
            </div>
        </div>
        <div class="h-64"><canvas id="trendChart"></canvas></div>
    </div>
    <div class="animate-in animate-delay-7 bg-white border border-gray-200 rounded-2xl p-5">
        <div class="mb-5">
            <h3 class="text-sm font-bold text-gray-900">Kategori Lowongan</h3>
            <p class="text-xs text-gray-400 mt-0.5">Distribusi berdasarkan kategori</p>
        </div>
        <div class="h-48 flex items-center justify-center"><canvas id="categoryChart"></canvas></div>
        <div class="mt-4 space-y-2">
            <div class="flex items-center justify-between text-xs"><div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-blue-600"></span><span class="text-gray-600">Teknologi</span></div><span class="text-gray-400 font-medium">34%</span></div>
            <div class="flex items-center justify-between text-xs"><div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-indigo-500"></span><span class="text-gray-600">Desain</span></div><span class="text-gray-400 font-medium">22%</span></div>
            <div class="flex items-center justify-between text-xs"><div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span><span class="text-gray-600">Marketing</span></div><span class="text-gray-400 font-medium">18%</span></div>
            <div class="flex items-center justify-between text-xs"><div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-purple-500"></span><span class="text-gray-600">Keuangan</span></div><span class="text-gray-400 font-medium">14%</span></div>
            <div class="flex items-center justify-between text-xs"><div class="flex items-center gap-2"><span class="w-2.5 h-2.5 rounded-full bg-gray-400"></span><span class="text-gray-600">Lainnya</span></div><span class="text-gray-400 font-medium">12%</span></div>
        </div>
    </div>
</div>

<!-- Jobs Table + Activity -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <div class="lg:col-span-2 animate-in animate-delay-8 bg-white border border-gray-200 rounded-2xl overflow-hidden">
        <div class="flex items-center justify-between px-5 py-4 border-b border-gray-100">
            <div>
                <h3 class="text-sm font-bold text-gray-900">Lowongan Terbaru</h3>
                <p class="text-xs text-gray-400 mt-0.5">Daftar lowongan yang baru ditambahkan</p>
            </div>
            <a href="/admin/jobs" class="text-xs text-blue-600 hover:text-blue-700 transition-colors font-medium flex items-center gap-1">Lihat Semua <i data-lucide="arrow-right" class="w-3 h-3"></i></a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead>
                    <tr class="text-left text-[10px] uppercase tracking-wider text-gray-400 border-b border-gray-100 bg-gray-50/50">
                        <th class="px-5 py-2.5 font-semibold">Lowongan</th>
                        <th class="px-5 py-2.5 font-semibold">Perusahaan</th>
                        <th class="px-5 py-2.5 font-semibold hidden sm:table-cell">Lokasi</th>
                        <th class="px-5 py-2.5 font-semibold hidden md:table-cell">Tipe</th>
                        <th class="px-5 py-2.5 font-semibold">Status</th>
                        <th class="px-5 py-2.5 font-semibold hidden lg:table-cell">Tanggal</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (recentJobs && recentJobs.length > 0) { %>
                        <% recentJobs.forEach(job => { %>
                            <tr class="table-row border-b border-gray-50">
                                <td class="px-5 py-3">
                                    <p class="font-semibold text-gray-900 text-sm"><%= job.title %></p>
                                    <p class="text-[11px] text-gray-400">
                                        <%= job.salary_min && job.salary_max ? 'Rp ' + (job.salary_min/1000000) + '-' + (job.salary_max/1000000) + 'jt/bulan' : 'Gaji Kompetitif' %>
                                    </p>
                                </td>
                                <td class="px-5 py-3">
                                    <div class="flex items-center gap-2">
                                        <% if (job.company_logo) { %>
                                            <img src="/images/companies/<%= job.company_logo %>" class="w-7 h-7 rounded-lg object-cover" alt="">
                                        <% } else { %>
                                            <div class="w-7 h-7 rounded-lg bg-blue-100 flex items-center justify-center text-[9px] font-bold text-blue-600">
                                                <%= job.company ? job.company.substring(0, 2).toUpperCase() : 'CO' %>
                                            </div>
                                        <% } %>
                                        <span class="text-gray-600 truncate max-w-[120px]"><%= job.company %></span>
                                    </div>
                                </td>
                                <td class="px-5 py-3 text-gray-500 hidden sm:table-cell"><%= job.location %></td>
                                <td class="px-5 py-3 hidden md:table-cell">
                                    <span class="text-[10px] bg-emerald-50 text-emerald-600 px-2 py-0.5 rounded-full font-medium"><%= job.type %></span>
                                </td>
                                <td class="px-5 py-3">
                                    <span class="inline-flex items-center gap-1 text-[10px] <%= job.status === 'active' ? 'bg-emerald-50 text-emerald-600' : 'bg-red-50 text-red-600' %> px-2 py-0.5 rounded-full font-medium">
                                        <span class="w-1.5 h-1.5 rounded-full <%= job.status === 'active' ? 'bg-emerald-500' : 'bg-red-500' %>"></span>
                                        <%= job.status === 'active' ? 'Aktif' : 'Suspended' %>
                                    </span>
                                </td>
                                <td class="px-5 py-3 text-gray-400 text-xs hidden lg:table-cell">
                                    <%= new Date(job.created_at).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="6" class="px-5 py-4 text-center text-xs text-gray-400">Belum ada lowongan baru.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
    <div class="animate-in animate-delay-8 bg-white border border-gray-200 rounded-2xl p-5">
        <div class="flex items-center justify-between mb-4">
            <div>
                <h3 class="text-sm font-bold text-gray-900">Aktivitas Terbaru</h3>
                <p class="text-xs text-gray-400 mt-0.5">Update real-time</p>
            </div>
        </div>
        <div class="space-y-4 max-h-[340px] overflow-y-auto pr-1">
            <% if (recentActivities && recentActivities.length > 0) { %>
                <% recentActivities.forEach(act => { %>
                    <div class="flex gap-3">
                        <div class="w-8 h-8 rounded-full <%= act.iconColor === 'emerald' ? 'bg-emerald-100 text-emerald-500' : act.iconColor === 'purple' ? 'bg-purple-100 text-purple-500' : 'bg-blue-100 text-blue-500' %> flex items-center justify-center flex-shrink-0 mt-0.5">
                            <i data-lucide="<%= act.icon %>" class="w-4 h-4"></i>
                        </div>
                        <div>
                            <p class="text-xs text-gray-600"><%= act.title %></p>
                            <p class="text-[10px] text-gray-400 mt-0.5">
                                <%= timeAgo(act.time) %>
                            </p>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-xs text-gray-400 text-center py-4">Belum ada aktivitas terbaru.</p>
            <% } %>
        </div>
    </div>
</div>

<!-- ===== Lamaran Terbaru - Grid Cards ===== -->
<div class="animate-in animate-delay-8 bg-white border border-gray-200 rounded-2xl p-5">
    <div class="flex items-center justify-between mb-5">
        <div>
            <h3 class="text-sm font-bold text-gray-900">Lamaran Terbaru</h3>
            <p class="text-xs text-gray-400 mt-0.5">Data lamaran yang masuk ke platform</p>
        </div>
        <div class="flex items-center gap-2">
            <div class="flex items-center gap-1 bg-gray-100 rounded-lg p-0.5">
                <button class="app-filter-btn px-3 py-1.5 text-[11px] rounded-md bg-blue-600 text-white font-medium" data-filter="all">Semua</button>
                <button class="app-filter-btn px-3 py-1.5 text-[11px] rounded-md text-gray-500 hover:text-gray-700" data-filter="applied">Pending</button>
                <button class="app-filter-btn px-3 py-1.5 text-[11px] rounded-md text-gray-500 hover:text-gray-700" data-filter="interviewing">Review</button>
            </div>
            <a href="/admin/users" class="text-xs text-blue-600 hover:text-blue-700 transition-colors font-medium flex items-center gap-1 ml-2">Lihat Semua <i data-lucide="arrow-right" class="w-3 h-3"></i></a>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4" id="applicationsGrid">
        <% if (recentApplicationsForReview && recentApplicationsForReview.length > 0) { %>
            <% recentApplicationsForReview.forEach(app => { %>
                <div class="app-card bg-white border border-gray-200 rounded-xl overflow-hidden" data-status="<%= app.status %>">
                    <%
                      let gradientClass = "from-yellow-400 to-orange-400";
                      let statusBg = "bg-yellow-50 text-yellow-600";
                      let statusDot = "bg-yellow-400";
                      let progressColor = "from-blue-500 to-blue-600";
                      
                      if (app.status === 'accepted' || app.status === 'offered') {
                        gradientClass = "from-emerald-400 to-teal-400";
                        statusBg = "bg-emerald-50 text-emerald-600";
                        statusDot = "bg-emerald-400";
                        progressColor = "from-emerald-400 to-emerald-500";
                      } else if (app.status === 'interviewing') {
                        gradientClass = "from-blue-400 to-indigo-400";
                        statusBg = "bg-blue-50 text-blue-600";
                        statusDot = "bg-blue-400";
                        progressColor = "from-blue-400 to-blue-500";
                      } else if (app.status === 'rejected' || app.status === 'declined') {
                        gradientClass = "from-red-400 to-pink-400";
                        statusBg = "bg-red-50 text-red-500";
                        statusDot = "bg-red-400";
                        progressColor = "from-red-400 to-red-500";
                      }
                    %>
                    <div class="h-1 bg-gradient-to-r <%= gradientClass %>"></div>
                    <div class="p-4">
                        <div class="flex items-start justify-between mb-3">
                            <div class="flex items-center gap-3">
                                <img src="<%= app.profile_image ? '/images/profiles/' + app.profile_image : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(app.seeker_name) %>" class="w-11 h-11 rounded-xl object-cover border-2 border-gray-100" alt="">
                                <div class="min-w-0 flex-1">
                                    <p class="text-sm font-bold text-gray-900 truncate leading-none mb-1"><%= app.seeker_name %></p>
                                    <p class="text-[11px] text-gray-400 truncate leading-none"><%= app.seeker_email %></p>
                                </div>
                            </div>
                            <span class="text-[10px] <%= statusBg %> px-2.5 py-1 rounded-full font-semibold flex items-center gap-1 flex-shrink-0">
                                <span class="w-1.5 h-1.5 rounded-full <%= statusDot %> <%= app.status === 'applied' ? 'status-dot-pending' : '' %>"></span>
                                <%= app.status === 'applied' ? 'Pending' : app.status === 'interviewing' ? 'Interview' : app.status === 'accepted' ? 'Diterima' : app.status === 'rejected' ? 'Ditolak' : app.status %>
                            </span>
                        </div>
                        <div class="bg-gray-50 rounded-lg p-3 mb-3">
                            <p class="text-[10px] text-gray-400 uppercase tracking-wider font-semibold mb-1">Melamar ke</p>
                            <div class="flex items-center gap-2">
                                <div class="w-6 h-6 rounded bg-blue-100 flex items-center justify-center text-[8px] font-bold text-blue-600 flex-shrink-0">
                                    <%= app.job_company ? app.job_company.substring(0, 2).toUpperCase() : 'CO' %>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-semibold text-gray-800 truncate"><%= app.job_title %></p>
                                    <p class="text-[10px] text-gray-400 truncate"><%= app.job_company %> · <%= app.job_location %></p>
                                </div>
                            </div>
                        </div>
                        <div class="flex flex-wrap gap-1.5 mb-3 h-[24px] overflow-hidden">
                            <% if (app.seeker_skills) { %>
                                <% app.seeker_skills.split(',').slice(0, 3).forEach(skill => { %>
                                    <span class="skill-tag text-[10px] px-2 py-0.5 rounded-full border border-gray-200 text-gray-500 bg-gray-50 truncate max-w-[70px]"><%= skill.trim() %></span>
                                <% }) %>
                            <% } else { %>
                                <span class="text-[10px] text-gray-400">Belum ada skill</span>
                            <% } %>
                        </div>
                        <div class="mb-3">
                            <%
                              let matchScore = 75;
                              if (app.seeker_skills) {
                                const skillsCount = app.seeker_skills.split(',').length;
                                matchScore = Math.min(65 + (skillsCount * 8), 98);
                              }
                            %>
                            <div class="flex items-center justify-between text-[10px] mb-1">
                                <span class="text-gray-400 font-medium">Kecocokan</span>
                                <span class="text-blue-600 font-bold"><%= matchScore %>%</span>
                            </div>
                            <div class="w-full bg-gray-100 rounded-full h-1.5">
                                <div class="progress-bar bg-gradient-to-r <%= progressColor %> h-1.5 rounded-full" data-percent="<%= matchScore %>"></div>
                            </div>
                        </div>
                        <div class="flex items-center justify-between">
                            <div class="flex items-center gap-1 text-[10px] text-gray-400">
                                <i data-lucide="clock" class="w-3 h-3"></i><%= timeAgo(app.created_at) %>
                            </div>
                            <div class="flex items-center gap-1">
                                <a href="/admin/users" class="action-btn p-1.5 rounded-lg bg-gray-50 text-gray-400 hover:bg-gray-100" title="Lihat Detail">
                                    <i data-lucide="eye" class="w-3.5 h-3.5"></i>
                                </a>
                                <a href="/admin/reports" class="action-btn p-1.5 rounded-lg bg-blue-50 text-blue-500 hover:bg-blue-100" title="Tinjau Laporan">
                                    <i data-lucide="clipboard-check" class="w-3.5 h-3.5"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-span-full py-8 text-center text-gray-400 text-xs">Belum ada lamaran masuk.</div>
        <% } %>
    </div>
</div>

<!-- Bottom Row -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
    <div class="animate-in animate-delay-8 bg-white border border-gray-200 rounded-2xl p-5">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-sm font-bold text-gray-900">Perusahaan Teratas</h3>
            <a href="/admin/jobs" class="text-[11px] text-blue-600 hover:text-blue-700 font-medium">Lihat Semua</a>
        </div>
        <div class="space-y-3">
            <% if (topCompanies && topCompanies.length > 0) { %>
                <% topCompanies.forEach(comp => { %>
                    <div class="flex items-center gap-3">
                        <% if (comp.profile_image) { %>
                            <img src="/images/profiles/<%= comp.profile_image %>" class="w-9 h-9 rounded-lg object-cover flex-shrink-0" alt="">
                        <% } else { %>
                            <div class="w-9 h-9 rounded-lg bg-blue-100 flex items-center justify-center text-[9px] font-bold text-blue-600 flex-shrink-0">
                                <%= comp.name ? comp.name.substring(0, 2).toUpperCase() : 'CO' %>
                            </div>
                        <% } %>
                        <div class="flex-1 min-w-0">
                            <p class="text-xs font-semibold text-gray-900 truncate leading-none mb-1"><%= comp.name %></p>
                            <p class="text-[10px] text-gray-400 leading-none"><%= comp.job_count %> lowongan · <%= comp.app_count %> lamaran</p>
                        </div>
                        <span class="text-[10px] <%= comp.status === 'active' ? 'text-emerald-600 bg-emerald-50' : 'text-red-600 bg-red-50' %> px-2 py-0.5 rounded-full font-medium flex-shrink-0">
                            <%= comp.status === 'active' ? 'Aktif' : 'Suspended' %>
                        </span>
                    </div>
                <% }) %>
            <% } else { %>
                <p class="text-xs text-gray-400 text-center py-4">Belum ada perusahaan.</p>
            <% } %>
        </div>
    </div>
    <div class="animate-in animate-delay-8 bg-white border border-gray-200 rounded-2xl p-5">
        <h3 class="text-sm font-bold text-gray-900 mb-4">Distribusi Lokasi</h3>
        <div class="space-y-3">
            <div><div class="flex items-center justify-between text-xs mb-1.5"><span class="text-gray-600 font-medium">Jakarta</span><span class="text-gray-400">42%</span></div><div class="w-full bg-gray-100 rounded-full h-2"><div class="progress-bar bg-blue-600 h-2 rounded-full" data-percent="42"></div></div></div>
            <div><div class="flex items-center justify-between text-xs mb-1.5"><span class="text-gray-600 font-medium">Bandung</span><span class="text-gray-400">18%</span></div><div class="w-full bg-gray-100 rounded-full h-2"><div class="progress-bar bg-indigo-500 h-2 rounded-full" data-percent="18"></div></div></div>
            <div><div class="flex items-center justify-between text-xs mb-1.5"><span class="text-gray-600 font-medium">Surabaya</span><span class="text-gray-400">15%</span></div><div class="w-full bg-gray-100 rounded-full h-2"><div class="progress-bar bg-emerald-500 h-2 rounded-full" data-percent="15"></div></div></div>
            <div><div class="flex items-center justify-between text-xs mb-1.5"><span class="text-gray-600 font-medium">Yogyakarta</span><span class="text-gray-400">12%</span></div><div class="w-full bg-gray-100 rounded-full h-2"><div class="progress-bar bg-purple-500 h-2 rounded-full" data-percent="12"></div></div></div>
            <div><div class="flex items-center justify-between text-xs mb-1.5"><span class="text-gray-600 font-medium">Lainnya</span><span class="text-gray-400">13%</span></div><div class="w-full bg-gray-100 rounded-full h-2"><div class="progress-bar bg-gray-400 h-2 rounded-full" data-percent="13"></div></div></div>
        </div>
    </div>
    <div class="animate-in animate-delay-8 bg-white border border-gray-200 rounded-2xl p-5">
        <div class="mb-5"><h3 class="text-sm font-bold text-gray-900">Status Lamaran</h3><p class="text-xs text-gray-400 mt-0.5">Distribusi bulan ini</p></div>
        <div class="h-48">
            <canvas id="statusChart" 
                    data-pending="<%= stats.pendingApps %>" 
                    data-interview="<%= stats.interviewToday %>" 
                    data-accepted="<%= stats.acceptedApps %>" 
                    data-rejected="<%= stats.rejectedApps %>"></canvas>
        </div>
    </div>
</div>

<!-- Daily Chart -->
<div class="animate-in animate-delay-8 bg-white border border-gray-200 rounded-2xl p-5">
    <div class="mb-5"><h3 class="text-sm font-bold text-gray-900">Pendaftaran Harian</h3><p class="text-xs text-gray-400 mt-0.5">User baru 7 hari terakhir</p></div>
    <div class="h-48"><canvas id="dailyChart"></canvas></div>
</div>

<!-- Chart.js and Custom Actions Script -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script>
    document.querySelectorAll('.chart-period-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            document.querySelectorAll('.chart-period-btn').forEach(b => { b.classList.remove('bg-blue-600','text-white','font-medium'); b.classList.add('text-gray-500'); });
            btn.classList.add('bg-blue-600','text-white','font-medium'); btn.classList.remove('text-gray-500');
        });
    });

    // Application filter buttons
    document.querySelectorAll('.app-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
            // style switch
            document.querySelectorAll('.app-filter-btn').forEach(b => { b.classList.remove('bg-blue-600','text-white','font-medium'); b.classList.add('text-gray-500'); });
            btn.classList.add('bg-blue-600','text-white','font-medium'); btn.classList.remove('text-gray-500');
            
            // logic filter
            const filterValue = btn.getAttribute('data-filter');
            const cards = document.querySelectorAll('#applicationsGrid .app-card');
            
            cards.forEach(card => {
                const status = card.getAttribute('data-status');
                if (filterValue === 'all') {
                    card.style.display = 'block';
                } else if (filterValue === 'applied') {
                    if (status === 'applied') card.style.display = 'block';
                    else card.style.display = 'none';
                } else if (filterValue === 'interviewing') {
                    if (status === 'interviewing' || status === 'offered' || status === 'accepted') card.style.display = 'block';
                    else card.style.display = 'none';
                }
            });
        });
    });

    Chart.defaults.color = '#9CA3AF';
    Chart.defaults.borderColor = '#F3F4F6';
    Chart.defaults.font.family = 'Inter';
    Chart.defaults.font.size = 11;

    // Trend chart (Blue tones instead of Orange)
    const trendCtx = document.getElementById('trendChart').getContext('2d');
    const tg1 = trendCtx.createLinearGradient(0,0,0,250); tg1.addColorStop(0,'rgba(37,99,235,0.1)'); tg1.addColorStop(1,'rgba(37,99,235,0)');
    const tg2 = trendCtx.createLinearGradient(0,0,0,250); tg2.addColorStop(0,'rgba(99,102,241,0.1)'); tg2.addColorStop(1,'rgba(99,102,241,0)');

    new Chart(trendCtx, {
        type:'line',
        data:{ labels:['Jan','Feb','Mar','Apr','Mei','Jun'], datasets:[
            { label:'Pengguna Baru', data:[28,35,42,38,52,64], borderColor:'#2563EB', backgroundColor:tg1, fill:true, tension:0.4, borderWidth:2, pointRadius:4, pointBackgroundColor:'#2563EB', pointBorderColor:'#fff', pointBorderWidth:2 },
            { label:'Lamaran', data:[45,62,78,95,110,142], borderColor:'#6366F1', backgroundColor:tg2, fill:true, tension:0.4, borderWidth:2, pointRadius:4, pointBackgroundColor:'#6366F1', pointBorderColor:'#fff', pointBorderWidth:2 }
        ]},
        options:{ responsive:true, maintainAspectRatio:false, interaction:{intersect:false,mode:'index'}, plugins:{ legend:{position:'top',align:'end',labels:{boxWidth:8,boxHeight:8,usePointStyle:true,pointStyle:'circle',padding:20}}, tooltip:{backgroundColor:'#fff',titleColor:'#111827',bodyColor:'#6B7280',borderColor:'#E5E7EB',borderWidth:1,cornerRadius:8,padding:12} }, scales:{ x:{grid:{display:false}}, y:{grid:{color:'#F3F4F6'},ticks:{padding:8}} } }
    });

    // Category chart (Blue primary)
    new Chart(document.getElementById('categoryChart'), {
        type:'doughnut',
        data:{ labels:['Teknologi','Desain','Marketing','Keuangan','Lainnya'], datasets:[{data:[34,22,18,14,12],backgroundColor:['#2563EB','#4F46E5','#10B981','#8B5CF6','#9CA3AF'],borderWidth:0,hoverOffset:6}] },
        options:{ responsive:true, maintainAspectRatio:false, cutout:'70%', plugins:{ legend:{display:false}, tooltip:{backgroundColor:'#fff',titleColor:'#111827',bodyColor:'#6B7280',borderColor:'#E5E7EB',borderWidth:1,cornerRadius:8,padding:12,callbacks:{label:(c)=>`${c.label}: ${c.raw}%`}} } }
    });

    // Status Chart
    const statusChartEl = document.getElementById('statusChart');
    const pendingVal = parseInt(statusChartEl.getAttribute('data-pending')) || 0;
    const interviewVal = parseInt(statusChartEl.getAttribute('data-interview')) || 0;
    const acceptedVal = parseInt(statusChartEl.getAttribute('data-accepted')) || 0;
    const rejectedVal = parseInt(statusChartEl.getAttribute('data-rejected')) || 0;

    new Chart(statusChartEl, {
        type:'bar',
        data:{ labels:['Pending','Review','Interview','Diterima','Ditolak'], datasets:[{data:[pendingVal, 84, interviewVal, acceptedVal, rejectedVal],backgroundColor:['#FBBF24','#8B5CF6','#2563EB','#10B981','#EF4444'],borderRadius:6,borderSkipped:false,barThickness:28}] },
        options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false}, tooltip:{backgroundColor:'#fff',titleColor:'#111827',bodyColor:'#6B7280',borderColor:'#E5E7EB',borderWidth:1,cornerRadius:8,padding:12} }, scales:{ x:{grid:{display:false}}, y:{grid:{color:'#F3F4F6'},ticks:{padding:8}} } }
    });

    // Daily Chart (Emerald)
    const dailyCtx = document.getElementById('dailyChart').getContext('2d');
    const dg = dailyCtx.createLinearGradient(0,0,0,180); dg.addColorStop(0,'rgba(16,185,129,0.15)'); dg.addColorStop(1,'rgba(16,185,129,0)');

    new Chart(dailyCtx, {
        type:'bar',
        data:{ labels:['Sen','Sel','Rab','Kam','Jum','Sab','Min'], datasets:[{label:'Pendaftar Baru',data:[8,12,6,15,11,4,7],backgroundColor:dg,borderColor:'#10B981',borderWidth:1,borderRadius:6,borderSkipped:false,barThickness:28}] },
        options:{ responsive:true, maintainAspectRatio:false, plugins:{ legend:{display:false}, tooltip:{backgroundColor:'#fff',titleColor:'#111827',bodyColor:'#6B7280',borderColor:'#E5E7EB',borderWidth:1,cornerRadius:8,padding:12,callbacks:{label:(c)=>`${c.raw} pendaftar`}} }, scales:{ x:{grid:{display:false}}, y:{grid:{color:'#F3F4F6'},ticks:{padding:8,stepSize:5}} } }
    });

    setTimeout(() => {
        document.querySelectorAll('.progress-bar').forEach(bar => { 
            const w = bar.getAttribute('data-percent'); 
            bar.style.width = '0%'; 
            setTimeout(() => { bar.style.width = w + '%'; }, 100); 
        });
    }, 500);
</script>
