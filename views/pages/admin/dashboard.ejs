<%
  function timeAgo(date) {
    const seconds = Math.floor((new Date() - new Date(date)) / 1000);
    let interval = Math.floor(seconds / 31536000);
    if (interval >= 1) return interval + " tahun lalu";
    interval = Math.floor(seconds / 2592000);
    if (interval >= 1) return interval + " bulan lalu";
    interval = Math.floor(seconds / 86400);
    if (interval >= 1) return interval + " hari lalu";
    interval = Math.floor(seconds / 3600);
    if (interval >= 1) return interval + " jam lalu";
    interval = Math.floor(seconds / 60);
    if (interval >= 1) return interval + " menit lalu";
    return "baru saja";
  }
%>

<style>
    .stat-card { transition: all 0.2s ease; }
    .stat-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,0.08); }

    .app-card { transition: all 0.2s ease; }
    .app-card:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0,0,0,0.08); border-color: #93C5FD; }

    .table-row { transition: background 0.15s ease; }
    .table-row:hover { background: #F9FAFB; }

    @keyframes fadeInUp {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-in { animation: fadeInUp 0.35s ease forwards; }
    .animate-delay-1 { animation-delay: 0.04s; opacity: 0; }
    .animate-delay-2 { animation-delay: 0.08s; opacity: 0; }
    .animate-delay-3 { animation-delay: 0.12s; opacity: 0; }
    .animate-delay-4 { animation-delay: 0.16s; opacity: 0; }
    .animate-delay-5 { animation-delay: 0.2s; opacity: 0; }
    .animate-delay-6 { animation-delay: 0.24s; opacity: 0; }
    .animate-delay-7 { animation-delay: 0.28s; opacity: 0; }
    .animate-delay-8 { animation-delay: 0.32s; opacity: 0; }

    .progress-bar { transition: width 1s ease; }

    .skill-tag { transition: all 0.15s ease; }
    .skill-tag:hover { background: #EFF6FF; color: #2563EB; border-color: #93C5FD; }

    .action-btn { transition: all 0.15s ease; }
    .action-btn:hover { transform: scale(1.1); }

    .status-dot-pending { animation: pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite; }
    @keyframes pulse { 50% { opacity: 0.5; } }
</style>

<!-- ===== Stat Cards ===== -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <!-- Total Pengguna -->
    <div class="stat-card animate-in animate-delay-1 bg-white border border-gray-200 rounded-2xl p-5 relative overflow-hidden">
        <div class="absolute -top-4 -right-4 w-16 h-16 bg-blue-50 rounded-full"></div>
        <div class="flex items-start justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-blue-100 flex items-center justify-center">
                <i data-lucide="users" class="w-5 h-5 text-blue-600"></i>
            </div>
        </div>
        <p class="text-2xl font-bold tracking-tight text-gray-900"><%= stats.users %></p>
        <p class="text-xs text-gray-400 mt-0.5">Total Pengguna</p>
        <div class="mt-3 flex items-center gap-1.5 text-[10px] text-gray-400">
            <span class="text-blue-600 font-medium"><%= stats.seekerCount %></span> seeker ·
            <span class="text-indigo-500 font-medium"><%= stats.hrCount %></span> recruiter ·
            <span class="text-purple-500 font-medium"><%= stats.adminCount %></span> admin
        </div>
    </div>

    <!-- Total Lowongan -->
    <div class="stat-card animate-in animate-delay-2 bg-white border border-gray-200 rounded-2xl p-5 relative overflow-hidden">
        <div class="absolute -top-4 -right-4 w-16 h-16 bg-indigo-50 rounded-full"></div>
        <div class="flex items-start justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center">
                <i data-lucide="briefcase" class="w-5 h-5 text-indigo-600"></i>
            </div>
        </div>
        <p class="text-2xl font-bold tracking-tight text-gray-900"><%= stats.jobs %></p>
        <p class="text-xs text-gray-400 mt-0.5">Total Lowongan</p>
        <div class="mt-3 flex items-center gap-1.5 text-[10px] text-gray-400">
            <span class="text-emerald-500 font-medium"><%= stats.activeJobs %></span> aktif ·
            <span class="text-red-400 font-medium"><%= stats.expiredJobs %></span> expired ·
            <span class="text-gray-400 font-medium"><%= stats.suspendedJobs %></span> suspended
        </div>
    </div>

    <!-- Total Lamaran -->
    <div class="stat-card animate-in animate-delay-3 bg-white border border-gray-200 rounded-2xl p-5 relative overflow-hidden">
        <div class="absolute -top-4 -right-4 w-16 h-16 bg-emerald-50 rounded-full"></div>
        <div class="flex items-start justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center">
                <i data-lucide="file-check" class="w-5 h-5 text-emerald-500"></i>
            </div>
        </div>
        <p class="text-2xl font-bold tracking-tight text-gray-900"><%= stats.applications %></p>
        <p class="text-xs text-gray-400 mt-0.5">Total Lamaran</p>
        <div class="mt-3 flex items-center gap-1.5 text-[10px] text-gray-400">
            <span class="text-emerald-500 font-medium"><%= stats.acceptedApps %></span> diterima ·
            <span class="text-red-500 font-medium"><%= stats.rejectedApps %></span> ditolak ·
            <span class="text-yellow-500 font-medium"><%= stats.pendingApps %></span> pending
        </div>
    </div>

    <!-- Laporan Pending -->
    <div class="stat-card animate-in animate-delay-4 bg-white border border-gray-200 rounded-2xl p-5 relative overflow-hidden">
        <div class="absolute -top-4 -right-4 w-16 h-16 bg-red-50 rounded-full"></div>
        <div class="flex items-start justify-between mb-3">
            <div class="w-10 h-10 rounded-xl bg-red-100 flex items-center justify-center">
                <i data-lucide="flag" class="w-5 h-5 text-red-500"></i>
            </div>
        </div>
        <p class="text-2xl font-bold tracking-tight text-gray-900"><%= stats.pendingReports %></p>
        <p class="text-xs text-gray-400 mt-0.5">Laporan Pending</p>
        <div class="mt-3">
            <% 
              let pct = stats.totalReports > 0 ? Math.min((stats.pendingReports / stats.totalReports) * 100, 100) : 0; 
            %>
            <div class="w-full bg-gray-100 rounded-full h-1.5">
                <div class="progress-bar bg-red-400 h-1.5 rounded-full" data-percent="<%= pct %>"></div>
            </div>
            <p class="text-[10px] text-gray-400 mt-1"><%= stats.pendingReports %> dari <%= stats.totalReports %> laporan bulan ini</p>
        </div>
    </div>
</div>

<!-- Mini Stats -->
<div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="stat-card animate-in animate-delay-5 bg-white border border-gray-200 rounded-2xl p-4 flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-purple-100 flex items-center justify-center flex-shrink-0">
            <i data-lucide="video" class="w-5 h-5 text-purple-500"></i>
        </div>
        <div>
            <p class="text-xl font-bold text-gray-900"><%= stats.interviewToday %></p>
            <p class="text-[10px] text-gray-400">Interview Hari Ini</p>
        </div>
    </div>
    <div class="stat-card animate-in animate-delay-5 bg-white border border-gray-200 rounded-2xl p-4 flex items-center gap-3">
