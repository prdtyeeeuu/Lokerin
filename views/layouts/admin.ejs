<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Admin Panel | Lokerin' %></title>
    
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Tailwind Config -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                }
            }
        }
    </script>
    
    <!-- CSRF Token Meta -->
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <script>
        (function() {
          const origFetch = window.fetch;
          const csrfToken = "<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>";
          window.fetch = async function(...args) {
            let resource = args[0];
            let config = args[1];
            
            if (config && config.method && ['POST', 'PUT', 'PATCH', 'DELETE'].includes(config.method.toUpperCase())) {
              if (!config.headers) {
                config.headers = {};
              }
              if (config.headers instanceof Headers) {
                if (!config.headers.has('x-csrf-token')) config.headers.append('x-csrf-token', csrfToken);
              } else {
                config.headers['x-csrf-token'] = csrfToken;
              }
              args[1] = config;
            }
            return origFetch.apply(window, args);
          };
        })();
    </script>

    <style>
        * { font-family: 'Inter', sans-serif; }
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: #F3F4F6; }
        ::-webkit-scrollbar-thumb { background: #D1D5DB; border-radius: 3px; }
        ::-webkit-scrollbar-thumb:hover { background: #9CA3AF; }

        .sidebar-link { transition: all 0.15s ease; }
        .sidebar-link:hover { background: #F3F4F6; color: #111827; }
        .sidebar-link.active { background: #EFF6FF; color: #2563EB; font-weight: 600; }
        .sidebar-link.active .sidebar-icon { color: #2563EB; }

        .sidebar-overlay { display: none; }
        .sidebar-mobile-open .sidebar-overlay { display: block; }
        @media (max-width: 1023px) {
            .sidebar-panel { transform: translateX(-100%); transition: transform 0.3s ease; position: fixed; z-index: 50; height: 100vh; }
            .sidebar-mobile-open .sidebar-panel { transform: translateX(0); }
        }

        .notification-dot::after {
            content: '';
            position: absolute;
            top: 6px; right: 6px;
            width: 7px; height: 7px;
            background: #2563EB;
            border-radius: 50%;
            border: 1.5px solid white;
        }
    </style>
    
    <!-- Extracted Styles -->
    <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body class="bg-gray-50 text-gray-900 min-h-screen">

    <div class="sidebar-overlay fixed inset-0 bg-black/30 z-40 lg:hidden" onclick="toggleSidebar()"></div>

    <!-- Sidebar -->
    <aside class="sidebar-panel fixed top-0 left-0 h-full w-60 bg-white border-r border-gray-200 z-50 flex flex-col lg:translate-x-0">
        <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
            <a href="/" class="flex items-center gap-2.5">
                <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center shadow-sm">
                    <i data-lucide="briefcase" class="w-4 h-4 text-white"></i>
                </div>
                <div>
                    <h1 class="text-sm font-bold tracking-tight text-gray-900">Lokerin</h1>
                    <p class="text-[9px] text-gray-400 uppercase tracking-widest font-medium">Admin Panel</p>
                </div>
            </a>
            <button class="lg:hidden text-gray-400 hover:text-gray-600" onclick="toggleSidebar()">
                <i data-lucide="x" class="w-5 h-5"></i>
            </button>
        </div>
        <nav class="flex-1 overflow-y-auto py-4 px-3">
            <p class="px-3 mb-2 text-[10px] uppercase tracking-widest text-gray-400 font-semibold">Admin Panel</p>
            
            <% 
              // Menentukan page active
              let currentActive = typeof active !== 'undefined' ? active : '';
              if (typeof title !== 'undefined' && title.includes('Dashboard')) currentActive = 'admin-dashboard';
              else if (typeof title !== 'undefined' && title.includes('Users')) currentActive = 'admin-users';
              else if (typeof title !== 'undefined' && title.includes('Jobs')) currentActive = 'admin-jobs';
              else if (typeof title !== 'undefined' && title.includes('Reports')) currentActive = 'admin-reports';
              else if (typeof title !== 'undefined' && title.includes('Gambar')) currentActive = 'admin-images';
            %>

            <a href="/admin/dashboard" class="sidebar-link <%= currentActive === 'admin-dashboard' ? 'active' : '' %> flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-500 mb-0.5">
                <i data-lucide="layout-dashboard" class="w-[18px] h-[18px] sidebar-icon"></i>Dashboard
            </a>
            <a href="/admin/users" class="sidebar-link <%= currentActive === 'admin-users' ? 'active' : '' %> flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-500 mb-0.5">
                <i data-lucide="users" class="w-[18px] h-[18px] sidebar-icon"></i>Users
                <% if (typeof sidebarStats !== 'undefined' && sidebarStats.users) { %>
                    <span class="ml-auto bg-blue-50 text-blue-600 text-[10px] font-semibold px-1.5 py-0.5 rounded-full"><%= sidebarStats.users %></span>
                <% } %>
            </a>
            <a href="/admin/jobs" class="sidebar-link <%= currentActive === 'admin-jobs' ? 'active' : '' %> flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-500 mb-0.5">
                <i data-lucide="briefcase" class="w-[18px] h-[18px] sidebar-icon"></i>Jobs
            </a>
            <a href="/admin/reports" class="sidebar-link <%= currentActive === 'admin-reports' ? 'active' : '' %> flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-500 mb-0.5">
                <i data-lucide="flag" class="w-[18px] h-[18px] sidebar-icon"></i>Reports
                <% if (typeof sidebarStats !== 'undefined' && sidebarStats.pendingReports > 0) { %>
                    <span class="ml-auto bg-red-100 text-red-600 text-[10px] font-semibold px-1.5 py-0.5 rounded-full"><%= sidebarStats.pendingReports %></span>
                <% } %>
            </a>
            <a href="/admin/images" class="sidebar-link <%= currentActive === 'admin-images' ? 'active' : '' %> flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-500 mb-0.5">
                <i data-lucide="image" class="w-[18px] h-[18px] sidebar-icon"></i>Images
            </a>
            
            <p class="px-3 mt-6 mb-2 text-[10px] uppercase tracking-widest text-gray-400 font-semibold">Public</p>
            <a href="/" class="sidebar-link flex items-center gap-3 px-3 py-2 rounded-lg text-sm text-gray-500 mb-0.5">
                <i data-lucide="external-link" class="w-[18px] h-[18px] sidebar-icon"></i>Kembali ke Lokerin
            </a>
        </nav>
        <div class="p-3 border-t border-gray-100">
            <div class="bg-gray-50 rounded-xl p-3.5">
                <div class="flex items-center gap-3 mb-3">
                    <% let adminUser = typeof currentUser !== 'undefined' && currentUser ? currentUser : (typeof user !== 'undefined' && user ? user : null); %>
                    <% if (adminUser) { %>
                        <img src="<%= adminUser.profile_image ? '/images/profiles/' + adminUser.profile_image : 'https://ui-avatars.com/api/?name=' + encodeURIComponent(adminUser.name) %>" 
                             alt="Admin" class="w-9 h-9 rounded-full object-cover border border-gray-200">
                        <div class="min-w-0 flex-1 flex flex-col">
                            <p class="text-sm font-semibold text-gray-900 truncate leading-none mb-1"><%= adminUser.name %></p>
                            <p class="text-[10px] text-gray-400 truncate leading-none"><%= adminUser.email %></p>
                        </div>
                    <% } else { %>
                        <div class="w-9 h-9 rounded-full bg-blue-600 flex items-center justify-center text-white text-sm font-semibold">A</div>
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-semibold text-gray-900 truncate">Admin System</p>
                            <p class="text-[11px] text-gray-400 truncate">admin@test.com</p>
                        </div>
                    <% } %>
                </div>
                <form action="/logout" method="POST" class="w-full">
                    <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
                    <button type="submit" class="flex items-center gap-2 text-xs text-red-500 hover:text-red-600 transition-colors font-medium">
                        <i data-lucide="log-out" class="w-3.5 h-3.5"></i>Logout
                    </button>
                </form>
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="lg:ml-60 min-h-screen flex flex-col">
        <!-- Header -->
        <header class="sticky top-0 z-30 bg-white/80 backdrop-blur-xl border-b border-gray-100">
            <div class="flex items-center justify-between px-4 sm:px-6 py-3">
                <div class="flex items-center gap-4">
                    <button class="lg:hidden text-gray-500 hover:text-gray-700" onclick="toggleSidebar()">
                        <i data-lucide="menu" class="w-5 h-5"></i>
                    </button>
                    <div>
                        <h2 class="text-lg font-bold tracking-tight text-gray-900">
                            <%= typeof title !== 'undefined' ? title.split('|')[0].trim() : 'Admin Panel' %>
                        </h2>
                        <p class="text-xs text-gray-400">Selamat datang kembali, Admin! 👋</p>
                    </div>
                </div>
                <div class="flex items-center gap-2 sm:gap-3">
                    <div class="hidden md:flex items-center bg-gray-100 border border-gray-200 rounded-lg px-3 py-2 gap-2 w-56">
                        <i data-lucide="search" class="w-4 h-4 text-gray-400"></i>
                        <input type="text" placeholder="Cari sesuatu..." class="bg-transparent text-sm outline-none w-full placeholder-gray-400">
                    </div>
                    <button class="relative p-2 rounded-lg hover:bg-gray-100 transition-colors notification-dot">
                        <i data-lucide="bell" class="w-5 h-5 text-gray-500"></i>
                    </button>
                    <div class="hidden sm:flex items-center gap-2 text-xs text-gray-400 bg-gray-50 border border-gray-100 px-3 py-2 rounded-lg">
                        <i data-lucide="calendar" class="w-3.5 h-3.5"></i>
                        <span id="currentDate"></span>
                    </div>
                </div>
            </div>
        </header>

        <!-- Content Body -->
        <main class="flex-1 p-4 sm:p-6 space-y-5">
            <%- body %>
        </main>

        <footer class="border-t border-gray-100 bg-white px-6 py-4 flex items-center justify-between text-xs text-gray-400 mt-auto">
            <p>© 2025 Lokerin. Sistem Manajemen Rekrutmen.</p>
            <p>v2.1.0</p>
        </footer>
    </div>

    <script src="/js/lokerin-modal.js"></script>
    <script>
        lucide.createIcons();

        const now = new Date();
        const options = { weekday: 'short', year: 'numeric', month: 'short', day: 'numeric' };
        const dateEl = document.getElementById('currentDate');
        if (dateEl) {
            dateEl.textContent = now.toLocaleDateString('id-ID', options);
        }

        function toggleSidebar() {
            document.body.classList.toggle('sidebar-mobile-open');
        }
    </script>
    
    <!-- Extracted Scripts -->
    <%- typeof script !== 'undefined' ? script : '' %>
    <!-- Custom Popups -->
    <%- include('../partials/custom-popups') %>
</body>
</html>
